VITE_BASE=/

# 接口地址：生产构建直连本地 vey-gateway 运维桥接器（console 定位为全量管理）
VITE_GLOB_API_URL=http://127.0.0.1:8787
VITE_GATEWAY_API=http://127.0.0.1:8787

# 本地 vey-gateway 运维桥接器地址（vite 配置消费，不再硬编码）
VITE_GATEWAY_BRIDGE_URL=http://127.0.0.1:8787

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
